# Root deployment reference. Local Laravel runtime configuration lives in api/.env.
APP_NAME="PaathNexus AI"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8013
FRONTEND_URL=http://localhost:5174
CORS_ALLOWED_ORIGINS=http://localhost:5174
SANCTUM_TOKEN_EXPIRATION=60
PAATHNEXUS_PLATFORM_ADMIN_EMAILS=

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=paathnexus
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
AI_PROVIDER=
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
AI_DAILY_USER_LIMIT=30
AI_DAILY_ORGANIZATION_LIMIT=500
AI_MAX_TEACHER_DRAFT_TOKENS=1400
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
